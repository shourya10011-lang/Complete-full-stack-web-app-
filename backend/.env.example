# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=edulearn

# Security & JWT
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-edulearn-2025
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# CORS & Origin
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Server Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
